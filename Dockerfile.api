# ===================================================
# STAGE 1: Build & Prune Dependencies (Production)
# ===================================================
FROM node:24-alpine AS builder

# Native dependencies used by the API publish Alpine-compatible prebuilt binaries.
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Enable Corepack and activate pnpm
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

# Copy dependency manifests and the shared package required by the root postinstall
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api/package.json ./apps/api/

# Install dependencies (leveraging Docker cache)
RUN pnpm install --frozen-lockfile

# Copy target application source files
COPY apps/api ./apps/api

# Build dependencies and target app
RUN pnpm --filter @student-portal/shared run build
RUN pnpm --filter @student-portal/api run build
RUN cp -r apps/api/src/database/*.json apps/api/dist/database/ 2>/dev/null || true

# Deploy only the api package with production dependencies to a separate folder
RUN pnpm --filter @student-portal/api deploy --prod --legacy /app/pruned

# ===================================================
# STAGE 2: Lightweight Production Runtime
# ===================================================
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV API_PORT=4000

# Install runtime utilities (timezone data, certificates)
RUN apk add --no-cache tzdata ca-certificates

# Create non-root system user for security hardening
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Copy self-contained deployed application from builder
COPY --from=builder /app/pruned ./

# Enforce secure ownership of application files
RUN chown -R nestjs:nodejs /app

# Drop root privileges
USER nestjs

EXPOSE 4000

# Run using the production main entrypoint
CMD ["node", "dist/main.js"]
