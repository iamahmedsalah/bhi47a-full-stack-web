{
  "name": "student-portal",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "corepack pnpm --filter @student-portal/shared build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@student-portal/api",
    "dev:web": "turbo run dev --filter=@student-portal/web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@student-portal/api",
    "build:web": "turbo run build --filter=@student-portal/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "docker:prod": "docker compose up --build -d",
    "docker:prod:down": "docker compose down",
    "clean": "turbo run clean && rimraf .turbo"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "turbo": "2.11.5"
  }
}
