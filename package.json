{
  "name": "student-portal",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "corepack pnpm --filter @student-portal/shared build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@student-portal/api",
    "dev:web": "turbo run dev --filter=@student-portal/web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@student-portal/api",
    "build:web": "turbo run build --filter=@student-portal/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node apps/api/test/run-e2e.cjs",
    "test:services": "docker compose -p student-portal-e2e -f docker-compose.test.yml up -d --wait",
    "test:admissions:services": "docker compose -p student-portal-admissions-e2e -f docker-compose.admissions-test.yml up -d --wait",
    "test:admissions:e2e": "node apps/api/test/admissions/run.cjs",
    "test:services:down": "docker compose -p student-portal-e2e -f docker-compose.test.yml down",
    "test:browsers": "pnpm --filter @student-portal/api exec playwright install chromium",
    "test:stress": "node scripts/stress-test.mjs",
    "test:db-speed": "node scripts/db-query-benchmark.mjs",
    "docker:prod": "docker compose --env-file .env.prod -f docker-compose.prod.yml up --build -d --wait",
    "docker:prod:down": "docker compose --env-file .env.prod -f docker-compose.prod.yml down",
    "clean": "turbo run clean && rimraf .turbo",
    "test:control:e2e": "node apps/api/test/control/run.cjs",
    "test:control:audit": "node --test apps/api/test/control-data-audit.test.cjs",
    "test:control:browser": "node apps/web/tests/control-workbook.browser.mjs",
    "test:control:release:browser": "node apps/web/tests/control-release.browser.mjs",
    "seed:control:demo": "node scripts/seed-control-demo.cjs",
    "test:control:services": "docker compose -p student-portal-control-e2e -f docker-compose.control-test.yml up -d --wait",
    "audit:control:acceptance": "node apps/api/test/control/acceptance-audit.cjs",
    "test:control:restore": "node --experimental-require-module apps/api/test/control/restore-rehearsal.cjs",
    "test:control:acceptance-safety": "node --test apps/api/test/control/acceptance-audit-safety.test.cjs apps/api/test/control/restore-safety.test.cjs"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "turbo": "2.11.5"
  }
}
