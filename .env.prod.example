# ===================================================
# Production Environment Template (.env.prod)
# Copy to .env.prod on VPS and restrict: chmod 600 .env.prod
# NEVER commit .env.prod to Git.
#
# Generate secrets on VPS:
#   openssl rand -hex 24     # For REDIS_PASSWORD
#   openssl rand -base64 48  # For JWT_SECRET (must be >= 32 bytes)
#   openssl rand -hex 16     # For METRICS_SCRAPE_SECRET
# ===================================================

# Server & Network
NODE_ENV=production
# Disabled until deployment-specific RP/origins and acceptance tests are verified.
PASSKEYS_ENABLED=false
PASSKEY_RP_ID=bhi47.app
PASSKEY_ORIGINS=https://bhi47.app
PASSKEY_RATE_LIMIT=20
PORT=4000
API_PORT=4000
APP_VERSION=1.0.0
# Must match the public HTTPS URL. No trailing slash.
# Optional fixed canonical origin and exact legacy web hosts for page redirects.
# Configure on the VPS; Vercel deployment is not used.
CANONICAL_WEB_ORIGIN=https://bhi47.app
LEGACY_WEB_HOSTS=portal.169-58-108-189.sslip.io
CLIENT_URL=https://bhi47.app
WEB_BASE_URL=https://bhi47.app
# Required by backend validation when CLIENT_URL is https. Same-origin so this is safe.
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
ENABLE_SWAGGER=false

# MongoDB Atlas
# Copy the EXISTING live Atlas URI, including its exact database name.
# Do not create a new database or run seed/reset/restore commands during deployment.
MONGODB_URI=mongodb+srv://<EXISTING_ATLAS_USER>:<EXISTING_ATLAS_PASSWORD>@<EXISTING_ATLAS_HOST>/<EXISTING_DATABASE_NAME>?retryWrites=true&w=majority
# Explicit DNS servers to guarantee SRV and TXT lookup in Docker containers
DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
SLOW_QUERY_THRESHOLD_MS=1000

# Redis Cache & Background Queues
REDIS_PASSWORD=<GENERATED_REDIS_PASSWORD_HEX_24>
REDIS_URL=redis://:<GENERATED_REDIS_PASSWORD_HEX_24>@redis:6379
QUEUE_REQUIRED=false
# Enable workers only at cutover, after disabling workers on the previous host.
QUEUE_WORKERS_ENABLED=false
# Avoid startup index maintenance while validating the existing database.
RUN_STARTUP_TASKS=false
RATE_LIMIT_STORE=mongo

# Request limits (these match the backend defaults; copy live overrides if different)
# Coarse per-IP network budgets PER MINUTE; campus Wi-Fi shares public addresses.
AUTH_IP_RATE_LIMIT=2400
GOOGLE_NONCE_RATE_LIMIT=1200
GOOGLE_AUTH_RATE_LIMIT=1200
PASSKEY_LOGIN_RATE_LIMIT=1800
# Authenticated Google linking is per user, per 15 minutes.
GOOGLE_LINK_RATE_LIMIT=12
STUDENT_LOGIN_RATE_LIMIT=8
ADMIN_LOGIN_RATE_LIMIT=8
CHANGE_PASSWORD_RATE_LIMIT=8
STUDENT_COMPLAINT_DAILY_RATE_LIMIT=3
STUDENT_COMPLAINT_REPLY_DAILY_RATE_LIMIT=3
PUBLIC_COMPLAINT_DAILY_RATE_LIMIT=3
FAQ_CHAT_RATE_LIMIT=20
ADMIN_UPLOAD_RATE_LIMIT=20
ADMIN_MESSAGE_RATE_LIMIT=30
FORGOT_PASSWORD_RATE_LIMIT=5
RESET_PASSWORD_OTP_RATE_LIMIT=5
GOOGLE_OTP_RATE_LIMIT=5
STUDENT_AI_CHAT_RATE_LIMIT=25
ADMIN_EXPORT_RATE_LIMIT=15
QUIZ_SUBMIT_RATE_LIMIT=30
QUIZ_DRAFT_RATE_LIMIT=60

# Account lockout (defaults: five failed attempts, thirty minutes)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=30

# JWT Authentication
JWT_SECRET=<GENERATED_JWT_SECRET_48_BYTES_BASE64>
JWT_EXPIRES_IN=7d
JWT_ISSUER=student-portal
JWT_AUDIENCE=student-portal-web
LEGACY_JWT_ACCEPT_UNTIL=
GOOGLE_NONCE_REQUIRED=true
# REQUIRED behind Nginx/Docker: exact source address seen by the API, usually the
# Docker bridge gateway /32 (NOT the public hostname/IP). See docs/security-session-details.md.
TRUST_PROXY_CIDRS=
# Approximate public-IP session locations via HTTPS; false disables external lookups.
SESSION_IP_LOOKUP_ENABLED=true
METRICS_SCRAPE_SECRET=<GENERATED_METRICS_SECRET_HEX_16>

# Google Gemini AI (required only for AI features)
GEMINI_API_KEY=
# Copy model IDs from the working live backend; uncomment after replacing values.
# GEMINI_CHAT_MODEL=<YOUR_CURRENT_CHAT_MODEL>
# GEMINI_EMBEDDING_MODEL=<YOUR_CURRENT_EMBEDDING_MODEL>
# Optional positive integer for the admin usage meter; NOT an enforced spending cap.
AI_MONTHLY_TOKEN_BUDGET=
# GEMINI_BASE_URL is not read by the current provider.

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# Email Service (Resend or SMTP required in production)
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM_EMAIL=noreply@<DOMAIN>
# Inbox sender display name; keeps the verified address above unchanged.
EMAIL_FROM_NAME=BHI47 Student Portal
# Complaint reply outbox runs on the VPS independently of BullMQ.
COMPLAINT_REPLY_EMAILS_ENABLED=false
EMAIL_SUPPORT_FROM=support@bhi47.app
EMAIL_SUPPORT_REPLY_TO=support@bhi47.appd
# SMTP Alternative:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=

# Google Authentication (must be identical)
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>.apps.googleusercontent.com

# Firebase Push Notifications (Optional - omit or comment if not configured)
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
FIREBASE_CLIENT_EMAIL=<FIREBASE_CLIENT_EMAIL>
# Keep private key on ONE single line wrapped in double quotes with literal \n
FIREBASE_PRIVATE_KEY="<-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n>"

# Existing administrators remain in Atlas. No admin bootstrap credentials needed.

# Admission security keys: stable across deploys; back up separately from MongoDB.
# Missing values disable public admission submissions safely.
# Generate on VPS:
#   openssl rand -base64 32  # For ADMISSIONS_ENCRYPTION_KEY (exact 32 random bytes, base64)
#   openssl rand -base64 48  # For ADMISSIONS_HMAC_KEY (separate >= 32-byte secret)
ADMISSIONS_ENCRYPTION_KEY=e3dc0c02d3c37bc09c93231b358e7080fdd67253bef6a1730fd8f42d76fa8606
ADMISSIONS_HMAC_KEY=e3dc0c02d3c37bc09c93231b358e7080fdd67253bef6a1730fd8f42d76fa8606

# Cloudflare Turnstile (Bot protection for public admissions)
# Note: NEXT_PUBLIC_TURNSTILE_SITE_KEY is also passed as a Docker build arg in docker-compose.prod.yml
# Use the distinct secret key and public site key from the same Cloudflare widget.
# Never put the secret key in NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=bhi47.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Admission Rate Limits (matches backend defaults in rate-limit.rules.ts)
ADMISSIONS_IP_RATE_LIMIT=120
ADMISSIONS_ACCESS_RATE_LIMIT=120
