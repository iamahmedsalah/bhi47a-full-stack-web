# ===================================================
# STAGE 1: Build Frontend App (Production)
# ===================================================
FROM node:24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Enable Corepack and activate pnpm
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

# Copy dependency manifests and the shared package required by the root postinstall
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/web/package.json ./apps/web/

# Install dependencies (leveraging Docker cache)
RUN pnpm install --frozen-lockfile

# Copy target application source files
COPY apps/web ./apps/web

# Setup build-time environment variables
# Same-origin by default: Nginx routes /api to the backend (override for split-origin setups).
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_APP_ENV=production
ARG NEXT_PUBLIC_APP_VERSION=1.0.0

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID}
ENV NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV}
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION}
# Next.js compiles pages and pre-renders static pages during build time.
ENV PORT=3000
ENV NODE_ENV=production

# Build packages
# BUILD_STANDALONE=true activates output: "standalone" in next.config.ts for Docker.
# Vercel builds do NOT set this, so Vercel's adapter owns the output format there.
ENV BUILD_STANDALONE=true
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN pnpm --filter @student-portal/shared run build
RUN pnpm --filter @student-portal/web run build

# ===================================================
# STAGE 2: Lightweight Next.js Runtime
# ===================================================
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Install runtime utilities
RUN apk add --no-cache tzdata ca-certificates

# Create non-root system user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy Next.js standalone directory output (already bundles node_modules and shared dependencies)
COPY --from=builder /app/apps/web/.next/standalone ./

# Copy public assets and static compilation directory (not included in standalone by default)
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

# Enforce secure ownership
RUN chown -R nextjs:nodejs /app

# Drop root privileges
USER nextjs

EXPOSE 3000

# Execute next.js standalone server
CMD ["node", "apps/web/server.js"]
