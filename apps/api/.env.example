# Runtime
NODE_ENV=development
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/student-portal
# Warm connection pool (avoids cold-start TLS handshakes on first query burst)
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
# Optional: shared secret for Prometheus scrapers on GET /api/metrics
METRICS_SCRAPE_SECRET=
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=student-portal
JWT_AUDIENCE=student-portal-web
# Absolute ISO timestamp, at most seven days ahead. Empty rejects old JWTs without sid.
LEGACY_JWT_ACCEPT_UNTIL=
# Passwords use bcrypt cost 12. Login never rewrites stored password hashes.
GOOGLE_NONCE_REQUIRED=true
# Exact trusted proxy source CIDRs only; empty trusts no forwarded headers.
TRUST_PROXY_CIDRS=
# Approximate session location via HTTPS ipwho.is (public IP only, 1.5s timeout).
# Vercel deployments prefer trusted edge geolocation. False disables external lookups.
SESSION_IP_LOOKUP_ENABLED=true
# Optional WebAuthn/passkeys. Keep false until staging acceptance is complete.
PASSKEYS_ENABLED=false
PASSKEY_RP_ID=localhost
PASSKEY_ORIGINS=http://localhost:3000
PASSKEY_RATE_LIMIT=20

# Browser origins. WEB_BASE_URL is the canonical web origin used in attendance QR links.
CLIENT_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Serverless/background processing
RATE_LIMIT_STORE=mongo
# Shared-network budgets per IP per minute; protected actions use verified user IDs.
AUTH_IP_RATE_LIMIT=2400
GOOGLE_NONCE_RATE_LIMIT=1200
GOOGLE_AUTH_RATE_LIMIT=1200
PASSKEY_LOGIN_RATE_LIMIT=1800
GOOGLE_LINK_RATE_LIMIT=12
QUIZ_SUBMIT_RATE_LIMIT=30
QUIZ_DRAFT_RATE_LIMIT=60
QUEUE_REQUIRED=false
QUEUE_WORKERS_ENABLED=false
RUN_STARTUP_TASKS=false

# Optional integrations
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional server-side Prometheus instant-query API for multi-replica traffic windows.
# Without it the dashboard explicitly shows process-local minute aggregates.
PROMETHEUS_URL=
PROMETHEUS_JOB=
PROMETHEUS_BEARER_TOKEN=
