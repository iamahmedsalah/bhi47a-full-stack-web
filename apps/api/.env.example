# Runtime
NODE_ENV=development
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/student-portal
# Warm connection pool (avoids cold-start TLS handshakes on first query burst)
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
# Optional: shared secret for Prometheus scrapers on GET /api/metrics
METRICS_SCRAPE_SECRET=
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins. WEB_BASE_URL is the canonical web origin used in attendance QR links.
CLIENT_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Serverless/background processing
RATE_LIMIT_STORE=mongo
QUEUE_REQUIRED=false
QUEUE_WORKERS_ENABLED=false
RUN_STARTUP_TASKS=false

# Optional integrations
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
