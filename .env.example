# Student Portal - Environment Variables
# Copy this file to .env and fill in your values from a local secret store.

# API
MONGODB_URI=mongodb://
DNS_SERVERS=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000,https://bhi47a-support.vercel.app,https://bhi47a-support-*.vercel.app
# Canonical web-app origin used by the API when generating attendance QR links.
# Set this to the web deployment, never the API deployment. No trailing slash.
WEB_BASE_URL=http://localhost:3000
API_PORT=4000
PORT=4000
NODE_ENV=development
# Cookie settings
# Local dev (same origin): lax
# Production with web + API on separate Vercel domains: none
#   SameSite=None is required so the browser sends the httpOnly JWT cookie on
#   cross-origin XHR/fetch calls. The API automatically forces Secure=true when
#   sameSite=none. Leaving this as "lax" on Vercel causes 401 on every
#   authenticated request immediately after login.
COOKIE_SAME_SITE=lax
# Leave blank for *.vercel.app deployments. Browsers reject cookies scoped to
# public suffixes like "vercel.app". Only set this when web and API share an
# exact parent domain (e.g. api.example.com + portal.example.com → example.com).
COOKIE_DOMAIN=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Optional monthly portal token budget used by the admin usage meter.
# Gemini does not expose an API-key remaining-token balance.
AI_MONTHLY_TOKEN_BUDGET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis / Upstash
# Must include redis:// or rediss://
REDIS_URL=redis://localhost:6379
QUEUE_REQUIRED=false
# Persistent BullMQ workers are disabled automatically on Vercel. Keep these
# false there; run workers in a separate always-on service if queues are needed.
QUEUE_WORKERS_ENABLED=false

# One-time data synchronization/index maintenance should not run on every
# serverless cold start. It is disabled automatically when VERCEL=1.
RUN_STARTUP_TASKS=false

# Rate limiting
RATE_LIMIT_STORE=mongo
STUDENT_LOGIN_RATE_LIMIT=8
ADMIN_LOGIN_RATE_LIMIT=8
CHANGE_PASSWORD_RATE_LIMIT=8
STUDENT_COMPLAINT_DAILY_RATE_LIMIT=3
STUDENT_COMPLAINT_REPLY_DAILY_RATE_LIMIT=3
PUBLIC_COMPLAINT_DAILY_RATE_LIMIT=3
FAQ_CHAT_RATE_LIMIT=20
ADMIN_UPLOAD_RATE_LIMIT=20
ADMIN_MESSAGE_RATE_LIMIT=30

# Account lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=30

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Gmail SMTP / Google App Password
# Prefer a Gmail app password, not your normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="Student Portal <your-gmail@gmail.com>"

# Google OAuth / Identity Services
# Use the same Web OAuth client ID for API token verification and browser GIS.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging - Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Default Admin Seed
# Use only for local development. Production must provide a strong one-time value.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional Staff Seed
STAFF_EMAIL=staff@institute.edu
STAFF_PASSWORD=StaffPass12345!
